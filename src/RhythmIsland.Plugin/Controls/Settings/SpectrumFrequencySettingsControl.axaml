<UserControl x:Class="RhythmIsland.Controls.Settings.SpectrumFrequencySettingsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:RhythmIsland.Controls.Settings">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SpectrumFrequencySettingsControl}}">
        <Separator Margin="0 16 0 8" />
        <ci:IconText Glyph="&#xEFF7;" Text="频谱" Margin="0 0 0 8" />
        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE5D1;}" Header="细节数量" Description="柱状时为柱数，曲线时为采样点数；数值越大，频率细节越丰富。">
            <fa:SettingsExpander.Footer><ComboBox Width="100" ItemsSource="{Binding Settings.AllowedBarCounts}" SelectedItem="{Binding Settings.BarCount, Mode=TwoWay}" /></fa:SettingsExpander.Footer>
        </fa:SettingsExpander>
        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE09B;}" Header="中心镜像" Description="将低频放在中间，高频向左右两侧对称展开。">
            <fa:SettingsExpander.Footer><ToggleSwitch IsChecked="{Binding Settings.HorizontalMirrorEnabled, Mode=TwoWay}" /></fa:SettingsExpander.Footer>
        </fa:SettingsExpander>
        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D9;}" Header="频率均衡补偿" Description="适当增强中高频，让频谱整体看起来更加均衡。">
            <fa:SettingsExpander.Footer>
                <ComboBox Width="140" SelectedIndex="{Binding Settings.FrequencyBalanceModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="原始" /><ComboBoxItem Content="均衡" /><ComboBoxItem Content="突出高频" />
                </ComboBox>
            </fa:SettingsExpander.Footer>
        </fa:SettingsExpander>
        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEFF7;}" Header="幅度" Description="调整频谱对声音的显示高度。">
            <fa:SettingsExpander.Footer>
                <Slider Width="240" Minimum="0.25" Maximum="3.00" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding Settings.Amplitude, Mode=TwoWay}" ci:SliderDragTooltipAssist.StringFormat="F2" Classes="auto-tooltip" />
            </fa:SettingsExpander.Footer>
        </fa:SettingsExpander>
        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8E1;}" Header="刷新率" Description="30 和 60 帧直接响应声音；更高档位会补充中间画面，也会增加资源占用。">
            <fa:SettingsExpander.Footer>
                <ComboBox Width="120" ItemsSource="{Binding Settings.AvailableFrameRates}" DisplayMemberBinding="{Binding DisplayName}"
                          SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Settings.FrameRate, Mode=TwoWay}" />
            </fa:SettingsExpander.Footer>
        </fa:SettingsExpander>
    </StackPanel>
</UserControl>
