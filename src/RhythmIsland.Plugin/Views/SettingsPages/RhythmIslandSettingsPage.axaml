<ci:SettingsPageBase
    x:Class="RhythmIsland.Views.SettingsPages.RhythmIslandSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:settingsControls="clr-namespace:RhythmIsland.Controls.Settings"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">
            <TextBlock Text="运行与诊断"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,0,0,8"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Text="管理默认扬声器捕获，并查看主界面频谱组件的运行状态。" />
            <Separator Margin="0,4" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEDB9;}"
                                 Header="运行状态"
                                 Description="开启后会读取默认扬声器正在播放的声音。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch OnContent="已开启"
                                  OffContent="已关闭"
                                  IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE0B5;}"
                                 Header="重启捕获"
                                 Description="{Binding RestartCaptureMessage}">
                <fa:SettingsExpander.Footer>
                    <Button Content="立即重启"
                            IsEnabled="{Binding Settings.IsEnabled}"
                            Command="{Binding RestartCaptureCommand}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D9;}"
                                 Header="捕获诊断"
                                 Description="这些信息用于判断声音捕获与频谱计算是否正在工作。"
                                 IsExpanded="True">
                <fa:SettingsExpanderItem Content="当前状态"
                                         Description="{Binding Status.StateDisplay}" />
                <fa:SettingsExpanderItem Content="默认扬声器"
                                         Description="{Binding Status.DeviceName}" />
                <fa:SettingsExpanderItem Content="最近频谱帧"
                                         Description="{Binding Status.LastFrameDisplay}" />
                <fa:SettingsExpanderItem Content="当前峰值"
                                         Description="{Binding Status.PeakDisplay}" />
                <fa:SettingsExpanderItem Content="最近错误"
                                         Description="{Binding Status.LastError}" />
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE946;}"
                                 Header="隐私说明"
                                 Description="只在内存中实时计算；不保存、不上传，也不记录音频或完整频谱历史。" />

            <Separator Margin="0,20,0,8" />
            <TextBlock Text="配套背景主题" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,0,0,8" Opacity="0.72" TextWrapping="Wrap"
                       Text="安装并在 Fluent 或 Classic 之后加载配套主题，即可在主要行背景显示同一套频谱。" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEFF7;}"
                                 Header="背景频谱"
                                 Description="只控制主要行背景频谱，不影响普通频谱组件。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch OnContent="已开启"
                                  OffContent="已关闭"
                                  IsChecked="{Binding Settings.BackgroundSpectrum.IsEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE82F;}"
                                 Header="主题状态"
                                 Description="{Binding BackgroundThemeStatus.StatusText}" />

            <settingsControls:SpectrumAppearanceSettingsControl Settings="{Binding Settings.BackgroundSpectrum}" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEE83;}" Header="基础外观"
                                 Description="调整主要行背景频谱的不透明度和显示长度。" IsExpanded="True">
                <fa:SettingsExpanderItem Content="不透明度" Description="只影响背景频谱，不修改 ClassIsland 原背景。">
                    <fa:SettingsExpanderItem.Footer>
                        <Slider Width="240" Minimum="0.10" Maximum="1.00" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.BackgroundSpectrum.Opacity, Mode=TwoWay}"
                                ci:SliderDragTooltipAssist.StringFormat="F2" Classes="auto-tooltip" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="固定长度" Description="开启后频谱保持指定长度，不再跟随主界面拉伸。">
                    <fa:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.BackgroundSpectrum.IsFixedWidthEnabled, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="频谱长度" Description="主界面更窄时会从两侧裁掉超出部分。"
                                         IsEnabled="{Binding Settings.BackgroundSpectrum.IsFixedWidthEnabled}">
                    <fa:SettingsExpanderItem.Footer>
                        <Slider Width="240" Minimum="120" Maximum="1920" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.BackgroundSpectrum.FixedWidth, Mode=TwoWay}"
                                ci:SliderDragTooltipAssist.StringFormat="F0" Classes="auto-tooltip" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <settingsControls:SpectrumFrequencySettingsControl Settings="{Binding Settings.BackgroundSpectrum}" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
