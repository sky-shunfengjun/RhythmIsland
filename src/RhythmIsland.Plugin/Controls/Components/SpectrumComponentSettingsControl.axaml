<controls:ComponentBase x:TypeArguments="models:SpectrumComponentSettings"
                        x:Class="RhythmIsland.Controls.Components.SpectrumComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:local="clr-namespace:RhythmIsland.Controls.Components"
                        xmlns:settingsControls="clr-namespace:RhythmIsland.Controls.Settings"
                        xmlns:models="clr-namespace:RhythmIsland.Models">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SpectrumComponentSettingsControl}}">
            <settingsControls:SpectrumAppearanceSettingsControl Settings="{Binding Settings}" />

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEE83;}" Header="基础外观"
                                 Description="调整此频谱组件的基础外观。" IsExpanded="True">
                <fa:SettingsExpanderItem Content="不透明度" Description="此组件的不透明度。">
                    <fa:SettingsExpanderItem.Footer>
                        <Slider Width="240" Minimum="0.10" Maximum="1.00" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Opacity, Mode=TwoWay}" ci:SliderDragTooltipAssist.StringFormat="F2" Classes="auto-tooltip" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="组件长度" Description="设置组件在主界面占用的横向宽度。">
                    <fa:SettingsExpanderItem.Footer>
                        <Slider Width="240" Minimum="60" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Width, Mode=TwoWay}" Classes="auto-tooltip" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <settingsControls:SpectrumFrequencySettingsControl Settings="{Binding Settings}" />

            <Separator Margin="0 16 0 8" />
            <ci:IconText Glyph="&#xEF27;" Text="功能" Margin="0 0 0 8" />
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE817;}" Header="无声自动收起"
                                 Description="一段时间没有声音后隐藏此组件，恢复声音时自动显示。">
                <fa:SettingsExpander.Footer><ToggleSwitch IsChecked="{Binding Settings.AutoCollapseEnabled, Mode=TwoWay}" /></fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="等待时间" Description="持续无声多久后收起。" IsEnabled="{Binding Settings.AutoCollapseEnabled}">
                    <fa:SettingsExpanderItem.Footer>
                        <ci:Field Suffix="秒">
                            <fa:NumberBox Width="170" Minimum="1" Maximum="120" SmallChange="1" SpinButtonPlacementMode="Inline"
                                          Value="{Binding Settings.SilenceCollapseDelaySeconds, Mode=TwoWay}" />
                        </ci:Field>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
