<controls:ComponentBase x:TypeArguments="models:SpectrumComponentSettings"
                        x:Class="RhythmIsland.Controls.Components.SpectrumComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:local="clr-namespace:RhythmIsland.Controls.Components"
                        xmlns:models="clr-namespace:RhythmIsland.Models"
                        mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SpectrumComponentSettingsControl}}">
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF0E2;}"
                                 Header="频谱方向"
                                 Description="选择柱体从底部生长，或从中间向上下展开。"
                                 IsExpanded="True">
                <fa:SettingsExpanderItem Content="底部向上">
                    <fa:SettingsExpanderItem.Footer>
                        <RadioButton GroupName="SpectrumDirection"
                                     IsChecked="{Binding Settings.IsBottomUpMode, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
                <fa:SettingsExpanderItem Content="上下镜像">
                    <fa:SettingsExpanderItem.Footer>
                        <RadioButton GroupName="SpectrumDirection"
                                     IsChecked="{Binding Settings.IsCenteredMode, Mode=TwoWay}" />
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D9;}"
                                 Header="柱数"
                Description="只影响这个组件；柱数越多，频率细节越丰富。">
                <fa:SettingsExpander.Footer>
                    <ComboBox Width="100"
                              ItemsSource="{Binding Settings.AllowedBarCounts}"
                              SelectedItem="{Binding Settings.BarCount, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE945;}"
                                 Header="幅度"
                                 Description="调整柱体对声音的显示高度，只影响这个组件。">
                <fa:SettingsExpander.Footer>
                    <Slider Width="240"
                            Minimum="0.25"
                            Maximum="3.00"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Settings.Amplitude, Mode=TwoWay}"
                            ci:SliderDragTooltipAssist.StringFormat="F2"
                            Classes="auto-tooltip" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A7;}"
                                 Header="透明度"
                                 Description="只影响这个频谱组件。">
                <fa:SettingsExpander.Footer>
                    <Slider Width="240"
                            Minimum="0.10"
                            Maximum="1.00"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Settings.Opacity, Mode=TwoWay}"
                            ci:SliderDragTooltipAssist.StringFormat="F2"
                            Classes="auto-tooltip" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE2B1;}"
                                 Header="自选颜色"
                                 Description="关闭时跟随这个组件的前景色。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ColorPicker IsVisible="{Binding Settings.UseCustomColor}"
                                     Color="{Binding Settings.CustomColor, Mode=TwoWay}" />
                        <ToggleSwitch IsChecked="{Binding Settings.UseCustomColor, Mode=TwoWay}" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEDA1;}"
                                 Header="组件长度"
                                 Description="设置这个频谱组件在主界面占用的横向宽度。">
                <fa:SettingsExpander.Footer>
                    <Slider Width="240"
                            Minimum="60"
                            Maximum="1200"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Settings.Width, Mode=TwoWay}"
                            Classes="auto-tooltip" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE7E7;}"
                                 Header="无声自动收起"
                                 Description="一段时间没有声音后隐藏这个组件，恢复声音时自动显示。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoCollapseEnabled, Mode=TwoWay}" />
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpanderItem Content="等待时间"
                                         Description="持续无声多久后收起。"
                                         IsEnabled="{Binding Settings.AutoCollapseEnabled}">
                    <fa:SettingsExpanderItem.Footer>
                        <ci:Field Suffix="秒">
                            <fa:NumberBox Width="170"
                                          Minimum="1"
                                          Maximum="120"
                                          SmallChange="1"
                                          SpinButtonPlacementMode="Inline"
                                          Value="{Binding Settings.SilenceCollapseDelaySeconds, Mode=TwoWay}" />
                        </ci:Field>
                    </fa:SettingsExpanderItem.Footer>
                </fa:SettingsExpanderItem>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
